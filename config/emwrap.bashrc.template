{
    "dispatcher": "$SCRIPTS/emwrap_dispatcher.sh",  
    "jobs": {
        "emw-import-ts": {
            "launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.base.import_ts",
            "label": "EMwrap Import TS",
            "output": "EMwrap"
        },
        "emw-warp-mctf": {
            "launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_mctf",
            "label": "Warp Motion and CTF",
            "output": "WarpMctf"
        },
        "emw-warp-aretomo": {
            "launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_aretomo",
            "label": "Warp Aretomo",
            "output": "WarpTsAlign"
        },
        "emw-warp-ctfrec": {
            "launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_ctfrec",
            "label": "Warp CTF and Reconstruction",
            "output": "WarpCtfRec"
        },
        "emw-warp-otf": {
            "launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_otf",
            "label": "Warp OTF Preprocessing",
            "output": "WarpOtf"
        },
        "emw-pytom-create_template": {
            "launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.pytom.pytom_create_template",
            "label": "PyTom Create Template",
            "output": "PyTom"
        },
        "emw-pytom": {
            "launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.pytom.pytom_pipeline",
            "label": "PyTom Template Matching",
            "output": "PyTom"
        },
        "emw-aretomo3": {
            "launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.aretomo.aretomo3_pipeline",
            "label": "Aretomo3",
            "output": "Aretomo3"
        },
        "emw-imod-reconstruct": {
            "launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.imod.imod_reconstruct",
            "label": "IMOD Reconstruct",
            "output": "ImodReconstruct"
        },
        "relion.reconstructtomograms": {
            "launcher": "$SCRIPTS/relion_job_launcher.sh",
            "label": "Relion Reconstruct Tomograms",
            "output": "Tomograms"
        },
        "emw-warp-aretomo": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_aretomo"},
        "emw-warp-etomo_patches": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_etomo_patches"},
        "emw-warp-ctfrec": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_ctfrec"},
        "emw-pytom-create_template": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.pytom.pytom_create_template"},
        "emw-pytom": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.pytom.pytom_pipeline"},
        "emw-pytme": {"launcher": "$SCRIPTS/emw-pytme.sh"},
        "emw-warp-export_particles": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_export_particles"},
        "emw-relion-tomorecons": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.relion.tomorecons"},
        "emw-relion-tomoinitial": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.relion.tomoinitial"},
        "emw-relion-tomorefine": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.relion.tomorefine"},
        "emw-relion-tomoclassify": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.relion.tomoclassify"},
        "emw-relion-symmetrize_volume": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.relion.symmetrize_volume"},
        "emw-relion-mask_create": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.relion.mask_create"},
        "emw-warp-mtools_create": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_mtools_create"},
        "emw-warp-mcore": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_mcore"},
        "emw-warp-estimate_weights": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_estimate_weights"},
        "emw-warp-mtools_resample": {"launcher": "$SCRIPTS/emwrap_launcher.sh emwrap.warp.warp_mtools_resample"}
