{
    "name": "emw-warp-tsalign",
    "label": "Warp - TS Align",
    "help": "Warp wrapper for tilt-series alignment using AreTomo2 or Etomo patch tracking. \n\n*REFERENCES*:\n[[https://warpem.github.io/warp/reference/warptools/api/tilt_series/?h=ts_aretomo#ts_aretomo][ts_aretomo]]\n[[https://warpem.github.io/warp/reference/warptools/api/tilt_series/?h=ts_etomo_patches#ts_etomo_patches][ts_etomo_patches]]",
    "sections": [
        {
            "label": "Import",
            "params": [
                {
                    "name": "input_tiltseries",
                    "label": "Input tilt series:",
                    "pattern": "",
                    "help": "STAR file with input tilt-series",
                    "paramClass": "PathParam",
                    "pointerClass": "TiltSeries"
                },
                {
                    "name": "ts_import.min_ntilts",
                    "label": "Min number of tilts",
                    "help": "",
                    "default": 35
                },
                {
                    "name": "ts_import.override_axis",
                    "label": "Angle for Tilt Axis (REMOVE)",
                    "default": 85,
                    "paramClass": "FloatParam",
                    "help": ""
                },
                {
                    "name": "create_settings.tomo_dimensions",
                    "label": "Tomogram dimensions:",
                    "default": "4096x4096x2000",
                    "help": ""
                },
                {
                    "name": "extra_ts_import",
                    "label": "ts_import extra arguments",
                    "paramClass": "StringParam",
                    "help": "Extra arguments to pass to ts_import"
                }
            ]
        },
        {
            "label": "Alignment",
            "params": [
                {
                    "name": "method",
                    "label": "Method",
                    "paramClass": "EnumParam",
                    "choices": {
                        "0": "aretomo2",
                        "1": "aretomo3",
                        "2": "etomo - patches"
                    },
                    "default": "0",
                    "help": "Select the tilt-series alignment method."
                },
                {
                    "label": "AreTomo",
                    "paramClass": "Group",
                    "condition": "method < 2",
                    "params": [
                        {
                            "name": "ts_aretomo.angpix",
                            "label": "Output pixel size (A/pix)",
                            "paramClass": "FloatParam",
                            "help": "Rescale tilt images to this pixel size; normally 10\u201315 A for cryo data; leave out to keep the original pixel size.",
                            "allowsEmpty": true
                        },
                        {
                            "name": "ts_aretomo.alignz",
                            "label": "Align Z (A)",
                            "default": 1800,
                            "paramClass": "FloatParam",
                            "help": "REQUIRED Value for AreTomo's AlignZ parameter in Angstroms (will be auto-converted to binned pixels), i.e. the thickness of the reconstructed tomogram used for alignments."
                        },
                        {
                            "name": "ts_aretomo.axis_iter",
                            "label": "Axis Iter",
                            "default": 0,
                            "paramClass": "FloatParam",
                            "help": ""
                        },
                        {
                            "name": "ts_aretomo.axis_batch",
                            "label": "Axis Batch",
                            "default": 0,
                            "paramClass": "FloatParam",
                            "help": ""
                        },
                        {
                            "name": "ts_aretomo.patches",
                            "label": "Patches",
                            "help": "Number of patches for local alignments in X, Y, separated by 'x': e.g. 6x4. By default (empty, or 0x0 or 1x1) only global alignment is performed. More patches increase the processing time."
                        }
                    ]
                },
                {
                    "label": "Etomo patches",
                    "paramClass": "Group",
                    "condition": "method == 2",
                    "params": [
                        {
                            "name": "ts_etomo_patches.angpix",
                            "label": "Output pixel size (A/pix)",
                            "paramClass": "FloatParam",
                            "help": "Rescale tilt images to this pixel size; normally 10\u201315 A for cryo data; leave out to keep the original pixel size.",
                            "allowsEmpty": true
                        },
                        {
                            "name": "ts_etomo_patches.patch_size",
                            "label": "Patch size (A)",
                            "default": 500,
                            "paramClass": "FloatParam",
                            "help": "Patch size for patch tracking in Angstroms"
                        },
                        {
                            "name": "ts_etomo_patches.initial_axis",
                            "label": "Initial axis",
                            "paramClass": "FloatParam",
                            "help": "Override initial tilt axis angle with this value",
                            "allowsEmpty": true
                        },
                        {
                            "name": "ts_etomo_patches.do_axis_search",
                            "label": "Do axis search",
                            "paramClass": "BooleanParam",
                            "help": "Fit a new tilt axis angle for the whole dataset"
                        }
                    ]
                }, 
                {
                    "label": "Shared Options",
                    "paramClass": "Group",
                    "params": [
                        {
                            "name": "ts_align.mask",
                            "label": "Mask",
                            "paramClass": "BooleanParam",
                            "help": "Apply mask to each image if available; masked areas will be filled with Gaussian noise"
                        },
                        {
                            "name": "ts_align.min_fov",
                            "label": "Min FOV",
                            "default": 0,
                            "paramClass": "FloatParam",
                            "help": "Disable tilts that contain less than this fraction of the tomogram's field of view due to excessive shifts"
                        }
                    ]
                }
            ]
        },
        {
            "label": "Compute",
            "params": [
                {
                    "name": "gpus",
                    "label": "GPUs",
                    "help": "If it is a single number (N), it will represent the total number of GPUs (0..N-1). It there are multiple values, it will be the specific GPUs ID."
                },
                {
                    "name": "perdevice",
                    "label": "Processes per device",
                    "default": 2,
                    "paramClass": "IntParam",
                    "help": "(--perdevice in ts_aretomo or ts_etomo_patches)"
                },
                {
                    "label": "Launchers",
                    "paramClass": "Group",
                    "help": "Launchers to use for the different programs",
                    "collapsed": true,
                    "params": [
                        {
                            "name": "launcher_warp",
                            "label": "WARP",
                            "paramClass": "StringParam",
                            "condition": "method == 0",
                            "help": "Launcher to use for Warp"
                        },
                        {
                            "name": "launcher_aretomo",
                            "label": "ARETOMO",
                            "paramClass": "StringParam",
                            "condition": "method == 0",
                            "help": "Launcher to use for Aretomo"
                        },
                        {
                            "name": "launcher_imod",
                            "label": "IMOD",
                            "paramClass": "StringParam",
                            "condition": "method == 2",
                            "help": "Launcher to use for IMOD etomo"
                        }
                    ]
                }
            ]
        }
    ]
}
