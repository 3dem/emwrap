{
    "name": "ApoF - AreTomo3 preprocessing",
    "description": "AreTomo3 preprocessing workflow for the ApoF tutorial dataset.",
    "jobs": [
        {
            "jobid": "EMwrap/job309",
            "jobtype": "emw-import-ts",
            "params": {
                "mdoc_files": "data/mdoc/*.mdoc",
                "tilt_axis_angle": "-85.6",
                "acq.voltage": "300",
                "acq.cs": "2.7",
                "acq.amplitude_contrast": "0.1",
                "wait.timeout": "1",
                "wait.file_change": "1",
                "wait.sleep": "1",
                "tilt_images": "data/frames/",
                "acq.gain": "data/gain_ref.mrc",
                "acq.pixel_size": "0.789",
                "acq.total_dose": "2.64",
                "acq.amplitude_constrast": "0.1"
            }
        },
        {
            "jobid": "Aretomo3/job310",
            "jobtype": "emw-aretomo3",
            "params": {
                "aretomo3.EerSampling": "1",
                "aretomo3.McBin": "3",
                "aretomo3.McPatch": "1 1",
                "aretomo3.AlignZ": "800",
                "aretomo3.DarkTol": "0.7",
                "aretomo3.AmpContrast": "0.07",
                "aretomo3.CorrCTF": true,
                "aretomo3.VolZ": "-1",
                "aretomo3.AtBin": "4 0",
                "aretomo3.Wbp": true,
                "aretomo3.Sart": "15 5",
                "aretomo3.TiltCor": "1",
                "aretomo3.ReconRange": "-60 60",
                "aretomo3.FlipVol": true,
                "aretomo3.OutImod": "1",
                "aretomo3.SplitSum": true,
                "input_tiltseries": "EMwrap/job309/tilt_series.star",
                "aretomo3.FmInt": "1",
                "aretomo3.Group": "",
                "aretomo3.TiltAxis": "-85.6 0",
                "aretomo3.AtPatch": "",
                "aretomo3.ExtZ": "0",
                "aretomo3.ExtraArgs": "",
                "gpus": "2",
                "cpus": "",
                "register_output_only": false,
                "launcher_aretomo3": "",
                "aretomo3.McGroup": "1 3",
                "aretomo3.ExtraA3Args": "",
                "acq.gain": ""
            }
        },
        {
            "jobid": "WarpMctf/job311",
            "jobtype": "emw-warp-mctf",
            "params": {
                "fs_motion_and_ctf.m_range_min": "500",
                "fs_motion_and_ctf.m_range_max": "10",
                "fs_motion_and_ctf.m_bfac": "-500",
                "fs_motion_and_ctf.m_grid": "1x1",
                "fs_motion_and_ctf.c_range_min": "30",
                "fs_motion_and_ctf.c_range_max": "7",
                "fs_motion_and_ctf.c_defocus_min": "0.5",
                "fs_motion_and_ctf.c_defocus_max": "8",
                "fs_motion_and_ctf.c_window": "512",
                "fs_motion_and_ctf.c_grid": "2x2",
                "fs_motion_and_ctf.perdevice": "2",
                "input_tiltseries": "EMwrap/job309/tilt_series.star",
                "create_settings.bin_angpix": "2.36",
                "create_settings.eer_ngroups": "",
                "extra_create_settings": "--gain_flip_y",
                "fs_motion_and_ctf.c_use_sum": true,
                "fs_motion_and_ctf.out_average_halves": true,
                "gpus": "1",
                "launcher_warp": "",
                "acq.gain": "",
                "register_output_only": false
            }
        },
        {
            "jobid": "Aretomo3Align/job314",
            "jobtype": "emw-aretomo3-align",
            "params": {
                "ctf_mode": "estimate",
                "aretomo3.AlignZ": "700",
                "aretomo3.DarkTol": "0.7",
                "aretomo3.AmpContrast": "0.07",
                "aretomo3.OutImod": "1",
                "aretomo3.SplitSum": true,
                "aretomo3.CorrCTF": true,
                "input_tiltseries": "WarpMctf/job311/tilt_series.star",
                "aretomo3.TiltAxis": "-85.6 0",
                "aretomo3.AtPatch": "",
                "aretomo3.ExtraArgs": "",
                "gpus": "2",
                "cpus": "",
                "register_output_only": false,
                "launcher_aretomo3": "",
                "UsePreviousAlignment": false
            }
        },
        {
            "jobid": "Aretomo3Reconstruct/job316",
            "jobtype": "emw-aretomo3-reconstruct",
            "params": {
                "UsePreviousAlignment": true,
                "aretomo3.VolZ": "-1",
                "aretomo3.AtBin": "4 0",
                "aretomo3.CorrCTF": true,
                "aretomo3.Wbp": true,
                "aretomo3.Sart": "15 5",
                "aretomo3.TiltCor": "1",
                "aretomo3.ReconRange": "-60 60",
                "aretomo3.FlipVol": true,
                "aretomo3.OutImod": "1",
                "aretomo3.SplitSum": true,
                "input_tiltseries": "Aretomo3Align/job314/aligned_tilt_series.star",
                "aretomo3.ExtZ": "0",
                "aretomo3.ExtraArgs": "",
                "gpus": "2",
                "cpus": "",
                "register_output_only": false,
                "launcher_aretomo3": "",
                "aretomo3.UsePreviousAlignment": true
            }
        }
    ]
}
