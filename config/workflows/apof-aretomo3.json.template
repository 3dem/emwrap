{
    "name": "ApoF - AreTomo3 preprocessing",
    "description": "Minimal AreTomo3 preprocessing workflow for the ApoF tutorial dataset.",                                                                                                                                                                                                                         
    "jobs": [                                                                                                                                                                                                             
        {                                                                                                                                                                                                                 
            "jobid": "External/job065",                                                                                                                                                                                   
            "jobtype": "emw-import-ts",                                                                                                                                                                                   
            "params": {                                                                                                                                                                                                   
                "mdoc_files": "data/mdoc/*mdoc",                                                                                                                                                                          
                "tilt_axis_angle": "-85.6",                                                                                                                                                                               
                "acq.voltage": "300",                                                                                                                                                                                     
                "acq.cs": "2.7",                                                                                                                                                                                          
                "acq.amplitude_contrast": "0.1",                                                                                                                                                                          
                "wait.timeout": "1",                                                                                                                                                                                      
                "wait.file_change": "1",                                                                                                                                                                                  
                "wait.sleep": "1",                                                                                                                                                                                        
                "tilt_images": "data/frames/",                                                                                                                                                                            
                "acq.gain": "data/gain_ref.mrc",                                                                                                                                                                          
                "acq.pixel_size": "0.789",
                "acq.total_dose": "2.64",
                "acq.amplitude_constrast": "0.1",
            }
        },
        {
            "jobid": "External/job066",
            "jobtype": "emw-aretomo3",
            "params": {
                "aretomo3.EerSampling": "1",
                "aretomo3.McBin": "4",
                "aretomo3.McPatch": "1 1",
                "aretomo3.AlignZ": "800",
                "aretomo3.DarkTol": "0.7",
                "aretomo3.AmpContrast": "0.07",
                "aretomo3.CorrCTF": true,
                "aretomo3.VolZ": "-1",
                "aretomo3.AtBin": "6 0",
                "aretomo3.Wbp": true,
                "aretomo3.Sart": "15 5",
                "aretomo3.TiltCor": "1",
                "aretomo3.ReconRange": "-60 60",
                "aretomo3.FlipVol": true,
                "aretomo3.OutImod": "3",
                "aretomo3.SplitSum": true,
                "input_tiltseries": "External/job065/tilt_series.star",
                "aretomo3.FmInt": "1",
                "aretomo3.McGroup": "1 3",
                "aretomo3.TiltAxis": "-85.6 0",
                "aretomo3.AtPatch": "",
                "aretomo3.ExtZ": "0",
                "aretomo3.ExtraArgs": "",
                "gpus": "1",
                "cpus": "",
                "register_output_only": false,
                "launcher_aretomo3": "",
                "aretomo3.ExtraA3Args": ""
            }
        }
    ]
}