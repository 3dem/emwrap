{
    "name": "ApoF - Warp + PyTOM + Relion",
    "description": "Same Warp Apoferritin tutorial, but using AreTomo2 for tilt-series alignment and PyTOM for template matching. It also uses Relion and M for refinements.",
    "jobs": [
        {
            "jobid": "EMwrap/job001",
            "jobtype": "emw-import-ts",
            "params": {
                "mdoc_files": "data/mdoc/*.mrc.mdoc",
                "tilt_axis_angle": "-85.6",
                "acq.voltage": "300",
                "acq.cs": "2.7",
                "acq.amplitude_contrast": "0.1",
                "wait.timeout": "1",
                "wait.file_change": "1",
                "wait.sleep": "1",
                "acq.amplitude_constrast": "0.1",
                "acq.gain": "data/gain_ref.mrc",
                "acq.pixel_size": "0.789",
                "acq.total_dose": "2.64",
                "tilt_images": "data/frames/",
                "do_queue": false
            }
        },
        {
            "jobid": "PyTom/job008",
            "jobtype": "emw-pytom-create_template",
            "params": {
                "gpus": "1",
                "pytom_create_template.input-map": "data/emd_15854.map",
                "pytom_create_template.input-voxel-size-angstrom": "0.729",
                "pytom_create_template.output-voxel-size-angstrom": "10",
                "pytom_create_template.box-size": "64",
                "pytom_create_template.center": false,
                "pytom_create_template.invert": false,
                "pytom_create_template.mirror": false,
                "pytom_create_mask.radius": "10",
                "pytom_create_mask.sigma": "1",
                "do_queue": false
            }
        },
        {
            "jobid": "WarpMctf/job002",
            "jobtype": "emw-warp-mctf",
            "params": {
                "fs_motion_and_ctf.m_range_min": "500",
                "fs_motion_and_ctf.m_range_max": "10",
                "fs_motion_and_ctf.m_bfac": "-500",
                "fs_motion_and_ctf.m_grid": "1x1",
                "fs_motion_and_ctf.c_range_min": "30",
                "fs_motion_and_ctf.c_range_max": "7",
                "fs_motion_and_ctf.c_defocus_min": "0.5",
                "fs_motion_and_ctf.c_defocus_max": "8",
                "fs_motion_and_ctf.c_window": "512",
                "fs_motion_and_ctf.c_grid": "2x2",
                "fs_motion_and_ctf.perdevice": "2",
                "create_settings.bin_angpix": "",
                "create_settings.eer_ngroups": "",
                "extra_create_settings": "--gain_flip_y",
                "fs_motion_and_ctf.c_use_sum": true,
                "fs_motion_and_ctf.out_average_halves": true,
                "gpus": "2",
                "input_tiltseries": "EMwrap/job001/tilt_series.star",
                "launcher_warp": "",
                "do_queue": false
            }
        },
        {
            "jobid": "WarpTsAlign/job003",
            "jobtype": "emw-warp-tsalign",
            "params": {
                "ts_import.min_ntilts": "3",
                "create_settings.tomo_dimensions": "4400x6000x1000",
                "method": "1",
                "ts_aretomo.alignz": "800",
                "ts_etomo_patches.patch_size": "500",
                "perdevice": "1",
                "extra_ts_import": "",
                "gpus": "2",
                "input_tiltseries": "WarpMctf/job002/tilt_series.star",
                "launcher_aretomo": "",
                "launcher_warp": "",
                "ts_aretomo.angpix": "10",
                "ts_aretomo.axis_batch": "0",
                "ts_aretomo.axis_iter": "0",
                "ts_aretomo.patches": "",
                "do_queue": false,
                "ts_align.mask": false,
                "ts_align.min_fov": "0",
                "ts_etomo_patches.angpix": "",
                "ts_etomo_patches.initial_axis": "",
                "ts_etomo_patches.do_axis_search": false,
                "launcher_imod": ""
            }
        },
        {
            "jobid": "WarpCtfRec/job004",
            "jobtype": "emw-warp-ctfrec",
            "params": {
                "ts_ctf.window": "512",
                "ts_ctf.range_low": "30",
                "ts_ctf.range_high": "7",
                "ts_ctf.defocus_min": "0.5",
                "ts_ctf.defocus_max": "8",
                "ts_ctf.perdevice": "2",
                "gpus": "2",
                "input_tiltseries": "WarpTsAlign/job003/aligned_tilt_series.star",
                "launcher_warp": "",
                "ts_reconstruct.angpix": "10",
                "ts_reconstruct.halfmap_frames": true,
                "do_queue": false
            }
        },
        {
            "jobid": "PyTom/job005",
            "jobtype": "emw-pytom",
            "params": {
                "pytom.low-pass": "20",
                "pytom.high-pass": "400",
                "pytom.random-phase-correction": true,
                "pytom.per-tilt-weighting": true,
                "pytom.tomogram-ctf-model": "phase-flip",
                "pytom_extract.particle-diameter": "140",
                "pytom_extract.n": "2500",
                "pytom_extract.tophat-filter": true,
                "pytom_extract.tophat-connectivity": "1",
                "gpus": "2",
                "input_tomograms": "WarpCtfRec/job004/tomograms.star",
                "pytom.angular-search": "20",
                "pytom.mask": "PyTom/job008/emd_15854_mask.mrc",
                "pytom.template": "PyTom/job008/emd_15854.mrc",
                "do_queue": false,
                "pytom.extra_args": "--rng-seed 1000",
                "launcher": ""
            }
        },
        {
            "jobid": "WarpExportParticles/job006",
            "jobtype": "emw-warp-export_particles",
            "params": {
                "filters.particles_max": "10000",
                "ts_export_particles.perdevice": "2",
                "filters.particles_min": "0",
                "gpus": "2",
                "input_tomograms": "WarpCtfRec/job004/tomograms.star",
                "input_coordinates": "PyTom/job005/optimisation_set.star",
                "launcher_warp": "",
                "ts_export_particles.box": "64",
                "ts_export_particles.diameter": "140",
                "ts_export_particles.output_angpix": "4",
                "ts_export_type": "2d",
                "do_queue": false
            }
        },
        {
            "jobid": "InitialModel/job007",
            "jobtype": "relion.initialmodel.tomo",
            "params": {
                "nr_iter": "50",
                "tau_fudge": "4",
                "nr_classes": "1",
                "sym_name": "O",
                "do_run_C1": false,
                "particle_diameter": "140",
                "do_solvent": true,
                "sigma_tilt": "-1",
                "do_ctf_correction": true,
                "do_parallel_discio": false,
                "nr_pool": "30",
                "nr_mpi": "1",
                "nr_threads": "32",
                "in_optimisation": "WarpExportParticles/job006/optimisation_set.star",
                "ctf_intact_first_peak": false,
                "do_combine_thru_disc": false,
                "use_gpu": true,
                "gpu_ids": "0,1",
                "gpus": "2",
                "other_args": "",
                "do_queue": false,
                "use_direct_entries": false,
                "in_particles": "",
                "in_tomograms": "",
                "in_trajectories": "",
                "fn_cont": "",
                "do_preread_images": false,
                "scratch_dir": ""
            }
        },
        {
            "jobid": "Refine3D/job020",
            "jobtype": "relion.refine3d.tomo",
            "params": {
                "trust_ref_size": true,
                "ini_high": "20",
                "sym_name": "O",
                "do_ctf_correction": true,
                "particle_diameter": "140",
                "do_zero_mask": true,
                "blush_version": "v1.0",
                "sampling": "7.5 degrees",
                "offset_range": "5",
                "offset_step": "1",
                "auto_local_sampling": "1.8 degrees",
                "sigma_tilt": "-1",
                "do_parallel_discio": false,
                "nr_pool": "30",
                "nr_mpi": "3",
                "nr_threads": "12",
                "in_optimisation": "WarpExportParticles/job006/optimisation_set.star",
                "fn_ref": "InitialModel/job007/initial_model.mrc",
                "fn_mask": "",
                "ref_correct_greyscale": false,
                "ctf_intact_first_peak": false,
                "do_solvent_fsc": true,
                "do_blush": false,
                "relax_sym": "",
                "auto_faster": false,
                "do_pad1": false,
                "do_combine_thru_disc": false,
                "use_gpu": true,
                "gpu_ids": "0:1",
                "gpus": "4",
                "other_args": "",
                "do_queue": false,
                "use_direct_entries": false,
                "in_particles": "",
                "in_tomograms": "",
                "in_trajectories": "",
                "fn_cont": "",
                "do_preread_images": false,
                "scratch_dir": ""
            }
        },
        {
            "jobid": "External/job021",
            "jobtype": "emw-relion-mask_create",
            "params": {
                "relion_mask_create.volume.ini_threshold": "0.02",
                "relion_mask_create.volume.lowpass": "15",
                "relion_mask_create.volume.angpix": "-1",
                "relion_mask_create.denovo.outer_radius": "99999",
                "relion_mask_create.denovo": false,
                "relion_mask_create.denovo.box_size": "",
                "relion_mask_create.denovo.center_x": "0",
                "relion_mask_create.denovo.center_y": "0",
                "relion_mask_create.denovo.center_z": "0",
                "relion_mask_create.denovo.inner_radius": "0",
                "relion_mask_create.volume.extend_inimask": "0",
                "relion_mask_create.volume.i": "Refine3D/job020/run_class001.mrc",
                "relion_mask_create.volume.invert": false,
                "relion_mask_create.volume.width_soft_edge": "0",
                "do_queue": false
            }
        },
        {
            "jobid": "WarpMCreatePopulation/job022",
            "jobtype": "emw-warp-mtools_create",
            "params": {
                "create_species.sym": "O",
                "gpus": "1",
                "create_population.name": "ApoF",
                "create_source.files": "",
                "create_source.nframes": "",
                "sources": [
                    {
                        "name": "ApoF",
                        "warp_folder": "WarpExportParticles/job006"
                    }
                ],
                "create_species.angpix_resample": "0.7894",
                "create_species.diameter": "140",
                "create_species.lowpass": "10",
                "create_species.mask": "External/job021/mask.mrc",
                "create_species.name": "ApoF",
                "create_species.particles_relion": "Refine3D/job020/run_data.star",
                "extra_create_species": "",
                "do_queue": false
            }
        }
    ]
}
