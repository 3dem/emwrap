{
    "title": "Tomo On-The-Fly",
    "description": "Tomography on-the-fly processing: import of tilt series (from mdoc files) while they are acquired, and both Warp (motion/CTF, alignment and reconstruction) and AreTomo3 processing from the imported tilt series. Processing jobs monitor the import output for new tilt series (input_timeout). Session specific values (mdoc pattern, acquisition, gain) are filled when the OTF project is created (see emwrap.mix.otf.TomoOTF).",
    "jobs": [
        {
            "jobid": "EMwrap/job001",
            "jobtype": "emw-import-ts",
            "params": {
                "mdoc_files": "data/*.mdoc",
                "tilt_axis_angle": "-85.6",
                "acq.voltage": "300",
                "acq.cs": "2.7",
                "acq.amplitude_contrast": "0.1",
                "wait.timeout": "28800",
                "wait.file_change": "60",
                "wait.sleep": "60",
                "acq.gain": "",
                "acq.pixel_size": "",
                "acq.total_dose": "",
                "tilt_images": "data/"
            }
        },
        {
            "jobid": "WarpOtf/job002",
            "jobtype": "emw-warp-otf",
            "params": {
                "mctf.fs_motion_and_ctf.m_range_min": "500",
                "mctf.fs_motion_and_ctf.m_range_max": "10",
                "mctf.fs_motion_and_ctf.m_bfac": "-500",
                "mctf.fs_motion_and_ctf.m_grid": "1x1",
                "mctf.fs_motion_and_ctf.c_range_min": "30",
                "mctf.fs_motion_and_ctf.c_range_max": "7",
                "mctf.fs_motion_and_ctf.c_defocus_min": "0.5",
                "mctf.fs_motion_and_ctf.c_defocus_max": "8",
                "mctf.fs_motion_and_ctf.c_window": "512",
                "mctf.fs_motion_and_ctf.c_grid": "2x2x1",
                "wat.create_settings.tomo_dimensions": "4400x6000x1000",
                "wat.ts_aretomo.alignz": "600",
                "perdevice": "2",
                "input_tiltseries": "EMwrap/job001/tilt_series.star",
                "mctf.extra_create_settings": "--gain_flip_y",
                "mctf.fs_motion_and_ctf.c_use_sum": false,
                "mctf.fs_motion_and_ctf.out_average_halves": false,
                "wat.extra_ts_import": "",
                "wat.ts_aretomo.angpix": "10",
                "wat.ts_aretomo.axis_iter": "0",
                "wat.ts_aretomo.axis_batch": "0",
                "wat.ts_aretomo.patches": "1x1",
                "ctfrec.ts_reconstruct.angpix": "10",
                "ctfrec.ts_reconstruct.halfmap_frames": false,
                "gpus": "2",
                "register_output_only": false,
                "launcher_warp": "",
                "wat.launcher_aretomo": "",
                "input_timeout": "28800"
            }
        },
        {
            "jobid": "Aretomo3/job003",
            "jobtype": "emw-aretomo3",
            "params": {
                "aretomo3.EerSampling": "1",
                "aretomo3.McBin": "3",
                "aretomo3.McPatch": "1 1",
                "aretomo3.AlignZ": "800",
                "aretomo3.DarkTol": "0.7",
                "aretomo3.AmpContrast": "0.07",
                "aretomo3.CorrCTF": true,
                "aretomo3.VolZ": "-1",
                "aretomo3.AtBin": "4 0",
                "aretomo3.Wbp": true,
                "aretomo3.Sart": "15 5",
                "aretomo3.TiltCor": "1",
                "aretomo3.ReconRange": "-60 60",
                "aretomo3.FlipVol": true,
                "aretomo3.OutImod": "1",
                "aretomo3.SplitSum": true,
                "input_tiltseries": "EMwrap/job001/tilt_series.star",
                "aretomo3.FmInt": "1",
                "aretomo3.Group": "",
                "aretomo3.TiltAxis": "-85.6 0",
                "aretomo3.AtPatch": "",
                "aretomo3.ExtZ": "0",
                "aretomo3.ExtraArgs": "",
                "gpus": "2",
                "cpus": "",
                "register_output_only": false,
                "launcher_aretomo3": "",
                "aretomo3.McGroup": "1 3",
                "aretomo3.ExtraA3Args": "",
                "acq.gain": "",
                "input_timeout": "28800"
            }
        }
    ]
}
